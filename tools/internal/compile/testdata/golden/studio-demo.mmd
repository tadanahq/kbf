flowchart LR
  %% entities
  customer["customer"]
  deliverable["deliverable"]
  employee["employee"]
  engagement["engagement"]
  offering["offering"]
  organization["organization"]
  purchase["purchase"]
  supplier["supplier"]
  transaction["transaction"]
  %% relations
  customer -->|belongs-to| customer
  customer -->|places| engagement
  customer -->|places| transaction
  employee -->|employed-by| organization
  employee -->|responsible-for| customer
  employee -->|responsible-for| engagement
  engagement -->|contains| deliverable
  offering -->|belongs-to| organization
  offering -->|supersedes| offering
  purchase -->|billed-to| organization
  supplier -->|supplies| offering
  supplier -->|supplies| purchase
  transaction -->|contains| offering
  transaction -->|derived-from| engagement
  transaction -->|derived-from| transaction
  %% actions
  action_annotate(("annotate"))
  action_annotate -.->|automatic| customer
  action_propose_extension(("propose-extension"))
  action_propose_extension -.->|required| organization
  action_request_sync(("request-sync"))
  action_request_sync -.->|required| organization
  action_flag_for_review(("flag-for-review"))
  action_flag_for_review -.->|automatic| transaction
